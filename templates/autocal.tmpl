#!/bin/bash

set -x

obsnum=OBSNUM
ramcopy=RAMCOPY

# If obsnum is a file, then we are in an array job
if [[ -f "${obsnum}" ]]; then
    taskid=${SLURM_ARRAY_TASK_ID}
    jobid=${SLURM_ARRAY_JOB_ID}

    echo "obsfile ${obsnum}"
    obsnum=$(sed -n -e "${SLURM_ARRAY_TASK_ID}"p "${obsnum}")
    echo "autocal obsid ${obsnum}"
    tmpdir=/tmp/slurm_autocal_${jobid}_${taskid}
else
    taskid=1
    jobid=${SLURM_JOB_ID}
    tmpdir=/tmp/slurm_autocal_${jobid}
fi

echo "jobid: ${jobid}"
echo "taskid: ${taskid}"

test_fail() {
if [[ $1 != 0 ]]; then
    track_task.py fail --jobid="${jobid}" --taskid="${taskid}" --finish_time="$(date +%s)"
    exit "$1"
fi
}

datadir=DATADIR
# Setting the reference antenna
if [[ $obsnum -gt 1201000000 ]] && [[ $obsnum -lt 1201400000 ]]; then
    refant=8
elif [[ $obsnum -gt 1300000000 ]] && [[ $obsnum -lt 1342950000 ]]; then
    refant=0
elif [[ $obsnum -gt 1342950000 ]] && [[ $obsnum -lt 1425294600 ]]; then
    refant=8
elif [[ $obsnum -gt 1425294600 ]] && [[ $obsnum -lt 1436999999 ]]; then
    refant=0
elif [[ $obsnum -gt 1451700000 ]] && [[ $obsnum -lt 1451800000 ]]; then # Jan 2026
    refant=8
elif [[ $obsnum -ge 1452536120 ]] && [[ $obsnum -le 1452542632 ]]; then # Everything else
    refant=21
elif [[ $obsnum -gt 1452542632 ]] || [[ $obsnum -lt 1300000000 ]]; then
    refant=7
fi
fraction=FRACTION
sthresh=STHRESH

# GLEAM-X sky model
catfile="${SOFTBASE}/sky_models/GGSM.txt"

# MWA beam information
MWAPATH="${GXMWAPB}"

# Minimum baseline of 75 lambda (=250m at 88 MHz) for calibration
minuv=75

# Perform ionospheric triage? (1 means yes, blank means no)
ion=IONOTEST

# start
track_task.py start --jobid="${jobid}" --taskid="${taskid}" --start_time="$(date +%s)"

cd "${datadir}/${obsnum}" || exit

metafits="${obsnum}.metafits"
if [[ ! -e ${metafits} ]] || [[ ! -s ${metafits} ]]; then
    wget -O "${metafits}" http://ws.mwatelescope.org/metadata/fits?obs_id=${obsnum}
    test_fail $?
fi

# In RAM or here?
if [[ -n $ramcopy ]]; then
    mkdir -p $tmpdir
    cp -rf ${obsnum}.ms $tmpdir
    mst=$tmpdir/${obsnum}.ms
else
    mst=${obsnum}.ms
fi

calibrator=$(pyhead.py -p CALIBSRC "$metafits" | awk '{print $3}' )
echo "Calibrator is $calibrator"

echo "Running infield calibration for $obsnum"
RA=$(pyhead.py -p RA "$metafits" | awk '{print $3}' )
Dec=$(pyhead.py -p DEC "$metafits" | awk '{print $3}' )
chan=$(pyhead.py -p CENTCHAN "$metafits" | awk '{print $3}' )

# Check whether the phase centre has already changed
# Calibration will fail if it has, so measurement set must be shifted back to its original position
current=$(chgcentre "${mst}") 

if [[ $current == *"shift"* ]]; then
    echo "Detected that this measurement set has undergone a denormal shift; this must be undone before calibration."
    coords=$(calc_optimum_pointing.py --metafits "${metafits}")
    echo "Optimally shifting co-ordinates of measurement set to $coords, without zenith shiftback."
    chgcentre \
            "${mst}" \
            ${coords}
else
    echo "Detected that this measurement set has not yet had its phase centre changed. Not shifting."
fi

# uv range for calibration based on GLEAM-based sky model
# Calibrate takes a maximum uv range in metres
# Calculate min uvw in metres
minuvm=$(echo "234 * ${minuv} / ${chan}" | bc -l)
# In wavelengths, maximum 128T baseline at 200MHz was 1667 lambda long
# 300/1.28 * 1667 = 390000
# Calculate max uvw in metres
maxuvm=$(echo "390000 / (${chan} + 11)" | bc -l)

if [[ -n $ion ]]; then
    echo "Performing ionospheric triage."

    ntimesteps=`taql "calc count([select distinct(TIME) from ${mst}])"`
    # Break the observation into 3 chunks of ntimesteps/3 timesteps each.
    chunk_size=$(echo "$ntimesteps / 3" | bc)

    # Ionospheric triage
    solutions1="${calmodel%%.txt}_solutions_ts1.bin"
    hyperdrive \
        di-calibrate \
        --max-iterations 500 \
        --timesteps $(eval echo {0..$(echo "$chunk_size - 1" | bc)}) \
        --num-sources 500 \
        --uvw-min "${minuv}lambda" \
        --uvw-max 1667lambda \
        --beam-file "${MWAPATH}/mwa_full_embedded_element_pattern.h5" \
        --outputs "${solutions1}" \
        -d "${mst}" "${obsnum}.metafits" \
        -s ${calmodel}
    
    hyperdrive \
        solutions-plot \
        --ref-tile ${refant} \
        --max-amp 2 \
        -m ${obsnum}.metafits \
        "${solutions1}" 

    solutions="${calmodel%%.txt}_solutions_ts2.bin"
    hyperdrive \
        di-calibrate \
        --timesteps $(eval echo {$chunk_size..$(echo "2 * $chunk_size - 1" | bc)}) \
        --max-iterations 500 \
        --num-sources 1000 \
        --uvw-min "${minuv}lambda" \
        --uvw-max 1667lambda \
        --beam-file "${MWAPATH}/mwa_full_embedded_element_pattern.h5" \
        --outputs "${solutions}" \
        -d "${mst}" "${obsnum}.metafits" \
        -s ${calmodel}

    hyperdrive \
        solutions-plot \
        --ref-tile ${refant} \
        --max-amp 2 \
        -m ${obsnum}.metafits \
        "${solutions}"

    solutions="${calmodel%%.txt}_solutions_ts3.bin"
    hyperdrive \
        di-calibrate \
        --timesteps $(eval echo {$(echo "2 * $chunk_size" | bc)..$(echo "$ntimesteps - 1" | bc)}) \
        --max-iterations 500 \
        --num-sources 1000 \
        --uvw-min "${minuv}lambda" \
        --uvw-max 1667lambda \
        --beam-file "${MWAPATH}/mwa_full_embedded_element_pattern.h5" \
        --outputs "${solutions}" \
        -d "${mst}" "${obsnum}.metafits" \
        -s ${calmodel}

    hyperdrive \
        solutions-plot \
        --ref-tile ${refant} \
        --max-amp 2 \
        -m ${obsnum}.metafits \
        "${solutions}" 

    echo "Ionospheric calibration finished. Creating plots and statistics. "

    python ${GXBASE}/gleam_x/bin/aocal_diff.py --metafits="${metafits}" --names --lastsol "${solutions}" "${solutions1}" --refant="${refant}"
    if [[ -n ${GXDBHOST} ]] && [[ -n ${GXDBPORT} ]] && [[ -n ${GXDBUSER} ]] && [[ -n ${GXDBPASS} ]]; then
        iono_update.py --ionocsv "${obsnum}_ionodiff.csv"
    fi
fi

# At the moment, assume that the ionosphere is OK, and derive some real solutions
solutions="${obsnum}_local_gleam_model_solutions_initial.bin"

# calibrate
hyperdrive \
    di-calibrate \
    --uvw-min "${minuv}lambda" \
    --max-iterations 500 \
    --num-sources 500 \
    --uvw-max 1667lambda \
    --beam-file "${MWAPATH}/mwa_full_embedded_element_pattern.h5" \
    --outputs "${solutions}" \
    -d "${mst}" "${obsnum}.metafits" \
    -s ${catfile}
test_fail $?

# Create a version divided through by the reference antenna, so that all observations have the same relative XY phase, allowing polarisation calibration solutions to be transferred
# This also sets the cross-terms to zero by default
aocal_phaseref.py "${solutions}" "${solutions%.bin}_ref.bin" "${refant}" --xy -2.806338586067941065e+01 --dxy -4.426533296449057023e-07  --ms "${obsnum}.ms"

# plot calibration solutions
hyperdrive \
    solutions-plot \
    --ref-tile ${refant} \
    --max-amp 2 \
    -m ${obsnum}.metafits \
    "${solutions%.bin}_ref.bin" 


test_fail $?

# Test to see if the calibration solution meets minimum quality control. At the moment
# this is a simple check based on the number of flagged solutions
result=$(check_assign_solutions.py -t "${fraction}" check "${solutions%.bin}_ref.bin")
if echo "${result}" | grep -q fail; then
    mv "${solutions%.bin}_ref.bin" "${solutions%.bin}_ref_failed.bin"
    test_fail 1
fi

if [[ -n $ramcopy ]]; then
    cp -rf ${mst} ${obsnum}.ms
    rm -rf $tmpdir
fi

track_task.py finish --jobid="${jobid}" --taskid="${taskid}" --finish_time="$(date +%s)"

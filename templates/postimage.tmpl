#! /bin/bash

set -x

obsinp=OBSINP
project_dir=PROJECT_DIR

# If obsinp is a file, then we are in an array job
if [[ -f "${obsinp}" ]]; then
    taskid="${SLURM_ARRAY_TASK_ID}"
    jobid="${SLURM_ARRAY_JOB_ID}"
    obsid="$(sed -n -e ${SLURM_ARRAY_TASK_ID}p ${obsinp})"
else
    taskid=1
    jobid="${SLURM_JOB_ID}"
    obsid="${obsinp}"
fi

test_fail() {
    if [[ $1 != 0 ]]; then
        if [[ "${GXTRACK}" == "track" ]]; then
            track_task.py fail --jobid="${jobid}" --taskid="${taskid}" --finish_time="$(date +%s)"
        fi
        exit "$1"
    fi
}

track_task.py start --jobid="${jobid}" --taskid="${taskid}" --start_time="$(date +%s)"

# Sub-channels
subchans="0000 0001 0002 0003 MFS"

# flux_warp method
method=scaled

# Sky model
POS_MODEL_CATALOGUE="${SOFTBASE}/sky_models/NVSS_SUMSS_psfcal.fits"
FLUX_MODEL_CATALOGUE="${SOFTBASE}/sky_models/GGSM_sparse_unresolved.fits"
# Set max separation for flux_warp crossmatch as ~ 1' -- unlikely that the ionosphere would be that brutal
separation=$(echo "60/3600" | bc -l)

# Set exclusion for flux_warp internal exclusive crossmatch as ~ 3'
exclusion=$(echo "180/3600" | bc -l)

cd "${project_dir}/${obsid}" || exit 1

metafits="${obsid}.metafits"
if [[ ! -f "${metafits}" ]] || [[ ! -s "${metafits}" ]]; then
    wget -O "${metafits}" "http://ws.mwatelescope.org/metadata/fits?obs_id=${obsid}"
    test_fail $?
fi

chan=$( pyhead.py -p CENTCHAN "$metafits" | awk '{print $3}' )
ra=$(pyhead.py -p RA "$metafits" | awk '{print $3}')
dec=$(pyhead.py -p DEC "$metafits" | awk '{print $3}')
b=$(python -c "import astropy.units as u; from astropy.coordinates import SkyCoord; print(abs(SkyCoord($ra*u.deg, $dec*u.deg).galactic.b.deg))")
minsrcs=500
if [[ "${chan}" -eq 69 ]] && (( $(echo  "$b < 10" | bc -l) )); then
    minsrcs=50
fi

metafits=$(ls -t ${obsid}*metafits* | head -1)

for subchan in ${subchans}; do
    BMAJ=$(pyhead.py -p BMAJ "${obsid}_deep-${subchan}-image-pb.fits" | awk '{print $3}' )
    if [[ "$BMAJ" == "0"  ]]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') # ERROR # ${obsid}_deep-${subchan}-image-pb.fits has zero-size PSF: something is broken!"
        exit 1
    fi
    
    if [[ ! -f "${obsid}_deep-${subchan}-image-pb_rms.fits" ]]; then
        BANE --cores 1 --compress --noclobber "${obsid}_deep-${subchan}-image-pb.fits"
    fi

    if [[ ! -f "${obsid}_deep-${subchan}-image-pb_comp.fits"  ]]; then
        # The mask_image.py operation will destructively remove the pixels. I can not think of a case 
        # where we actually want to keep pixels below 5% of the PB, apart from _maybe_ causing non-uniform
        # noise issues in the swarp image. In any case, the below attempts to preserve the original image
        # as a just in case. 
        if [[ ! -f "${obsid}_deep-${subchan}-image-pb_original.fits" ]]; then 
            cp -v "${obsid}_deep-${subchan}-image-pb.fits" "${obsid}_deep-${subchan}-image-pb_original.fits"
        fi
        if [[ ! -f "${obsid}_deep-${subchan}-image-pb.fits" ]]; then 
            if [[ ! -f "${obsid}_deep-${subchan}-image-pb_original.fits" ]]; then 
                echo "$(date '+%Y-%m-%d %H:%M:%S') # ERROR # Missing ${obsid}_deep-${subchan}-image-pb.fits file, and no copy found. This should not happen. "
                test_fail 2
            fi
            cp -v "${obsid}_deep-${subchan}-image-pb_original.fits" "${obsid}_deep-${subchan}-image-pb.fits"
        fi

        # Generate a weight map for mosaicking
        chans=($( pyhead.py -p CHANNELS "${obsid}.metafits" | awk '{print $3}' | sed "s/,/ /g" ))
        if [[ "${subchan}" == "MFS" ]]; then
            i=0
            j=23
        else
            n="${subchan:3}"
            i="$((n * 6))"
            j="$((i + 5))"
        fi
        cstart="${chans[$i]}"
        cend="${chans[$j]}"
        lookup_beam.py "${obsid}" \
        "_deep-${subchan}-image-pb.fits" \
        "${obsid}_deep-${subchan}-image-pb-" \
        -c "$cstart-$cend"

        mask_image.py "${obsid}_deep-${subchan}-image-pb.fits" \
        "${obsid}_deep-${subchan}-image-pb-XX-beam.fits" \
        "${obsid}_deep-${subchan}-image-pb-YY-beam.fits" \
        --apply-mask -v

        # move into place the new masked image
        # TODO: this will delete the -image-pb.fits but if mask didn't work you're just left with original and not -pb.fits: fix 
        rm "${obsid}_deep-${subchan}-image-pb.fits" && mv "${obsid}_deep-${subchan}-image-pb_mask.fits" "${obsid}_deep-${subchan}-image-pb.fits"

        BANE --cores 1 --compress --noclobber "${obsid}_deep-${subchan}-image-pb.fits"
        # TODO: Replace the redirection
        aegean  --autoload --table="./${obsid}_deep-${subchan}-image-pb.fits" "./${obsid}_deep-${subchan}-image-pb.fits" > >(tee -a "${obsid}_deep-${subchan}_aegean.log") 2> >(tee -a "${obsid}_deep-${subchan}_aegean.log" >&2)
    fi
    nsrc=$(grep "INFO found" "${obsid}_deep-${subchan}_aegean.log" | head -1 | awk '{print $3}')
    if [[ "${nsrc}" -lt "${minsrcs}" ]]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') # ERROR # Can't warp ${obsid} -- only ${nsrc} sources and minimum required id ${minsrcs} -- probably a horrible image"
    else
        RA=$( pyhead.py -p RA "${obsid}.metafits" | awk '{print $3}' )
        Dec=$( pyhead.py -p DEC "${obsid}.metafits" | awk '{print $3}' )
        chan=$( pyhead.py -p CENTCHAN "${obsid}.metafits" | awk '{print $3}' )
        mid=$( pyhead.py -p CRVAL3 "${obsid}_deep-${subchan}-image-pb.fits" | awk '{print $3}' )
        freqq=$(echo "${mid}" | awk '{printf "%03.0f",($1)/1e6}')
        
        # Roughly the centre and radius of the image:
        coords="$RA $Dec"
        # TODO make this dependent on CENTCHAN
        radius=50. #24.8
        
        if [[ ! -f "${obsid}_${subchan}_complete_sources_xm.fits" ]]; then
            fits_warp.py \
                --incat "${obsid}_deep-${subchan}-image-pb_comp.fits" \
                --refcat "${POS_MODEL_CATALOGUE}" \
                --xm "${obsid}_${subchan}_complete_sources_xm.fits" \
                --plot \
                --ra1 ra \
                --dec1 dec \
                --ra2 RAJ2000 \
                --dec2 DEJ2000 \
                --infits "${obsid}_deep-${subchan}-image-pb.fits"
        fi
        
        if [[ ! -f "${obsid}_deep-${subchan}-image-pb_warp.fits" ]]; then
            fits_warp.py \
                --incat "./${obsid}_deep-${subchan}-image-pb_comp.fits" \
                --refcat "${POS_MODEL_CATALOGUE}" \
                --corrected "./${obsid}_deep-${subchan}-image-pb_comp_warp-corrected.fits" \
                --xm "./${obsid}_${subchan}_fits_warp_xm.fits" \
                --suffix warp \
                --infits "./${obsid}_deep-${subchan}-image-pb.fits" \
                --ra1 ra --dec1 dec \
                --ra2 RAJ2000 --dec2 DEJ2000 \
                --plot \
                --nsrcs 750 \
                --vm 10 \
                --progress \
                --testimage \
                --signal peak_flux_1 \
                --enforce-min-srcs 100
                # --signal peak_flux --noise local_rms --SNR 10
        fi

        if [[ ! -f "${obsid}_${subchan}_xm.fits" ]]; then
            # flux_wrap dependency here
            # Match the image catalogue to the model table:
            match_catalogues \
                "${obsid}_deep-${subchan}-image-pb_comp_warp-corrected.fits" \
                "${FLUX_MODEL_CATALOGUE}" \
                --separation "${separation}" \
                --exclusion_zone "${exclusion}" \
                --outname "./${obsid}_${subchan}_xm.fits" \
                --threshold 0.5 \
                --nmax 1000 \
                --coords ${coords} \
                --radius "${radius}" \
                --ra2 "RAJ2000" \
                --dec2 "DEJ2000" \
                --ra1 "ra" \
                --dec1 "dec" \
                -F "int_flux" \
                --eflux "err_int_flux" \
                --localrms "local_rms"
        fi
        if [[ ! -f "${obsid}_deep-${subchan}-image-pb_warp_${method}_cf_output.txt" ]]; then
            flux_warp \
                "${obsid}_${subchan}_xm.fits" \
                "${obsid}_deep-${subchan}-image-pb_warp.fits" \
                --mode mean \
                --freq "${freqq}" \
                --threshold 0.5 \
                --nmax 400 \
                --flux_key "flux" \
                --smooth 5.0 \
                --ignore_magellanic \
                --localrms_key "local_rms" \
                --add-to-header \
                --ra_key "RAJ2000" \
                --dec_key "DEJ2000" \
                --index "alpha" \
                --curvature "beta" \
                --ref_flux_key "S_200" \
                --ref_freq 200.0 \
                --alpha -0.77 \
                --plot \
                --cmap "gnuplot2" \
                --update-bscale \
                --order 2 \
                --ext png \
                --nolatex
        fi
        factor=$(pyhead.py -p BSCALE "${obsid}_deep-${subchan}-image-pb_warp.fits" | awk '{print $3}')
        
        # The RMS and BKG maps will not have changed much from the ionospheric warping, so I can just
        # rename them and update BSCALE
        if [[ ! -f "${obsid}_deep-${subchan}-image-pb_rms.fits" ]]; then
            BANE --cores 1 --compress --noclobber "${obsid}_deep-${subchan}-image-pb.fits"
        fi
        
        mv "${obsid}_deep-${subchan}-image-pb_rms.fits" "${obsid}_deep-${subchan}-image-pb_warp_rms.fits"
        mv "${obsid}_deep-${subchan}-image-pb_bkg.fits" "${obsid}_deep-${subchan}-image-pb_warp_bkg.fits"
        pyhead.py -u BSCALE "$factor" "${obsid}_deep-${subchan}-image-pb_warp_bkg.fits"
        pyhead.py -u BSCALE "$factor" "${obsid}_deep-${subchan}-image-pb_warp_rms.fits"
        
        # rerun the source-finding -- don't save to the log this time as the numbers should not have changed
        if [[ ! -f "${obsid}_deep-${subchan}-image-pb_warp_comp.fits" ]]; then
            aegean --autoload --table="./${obsid}_deep-${subchan}-image-pb_warp.fits" "./${obsid}_deep-${subchan}-image-pb_warp.fits"
        fi
        if [[ ! -f "${obsid}_deep-${subchan}-image-pb_warp_weight.fits" ]]; then
            # Generate a weight map for mosaicking
            chans=($( pyhead.py -p CHANNELS "${obsid}.metafits" | awk '{print $3}' | sed "s/,/ /g" ))
            if [[ ${subchan} == "MFS" ]]; then
                i=0
                j=23
            else
                n="${subchan:3}"
                i="$((n * 6))"
                j="$((i + 5))"
            fi
            cstart="${chans[$i]}"
            cend="${chans[$j]}"
            lookup_beam.py "${obsid}" \
            "_deep-${subchan}-image-pb_warp.fits" \
            "${obsid}_deep-${subchan}-image-pb_warp-" \
            -c "$cstart-$cend"
            generate_weight_map.py "${obsid}_deep-${subchan}-image-pb_warp-XX-beam.fits" \
            "${obsid}_deep-${subchan}-image-pb_warp-YY-beam.fits" \
            "${obsid}_deep-${subchan}-image-pb_warp_rms.fits"
        fi
    fi
done

if [[ "${GXTRACK}" == "track" ]]; then
    track_task.py finish --jobid="${jobid}" --taskid="${taskid}" --finish_time="$(date +%s)"
fi

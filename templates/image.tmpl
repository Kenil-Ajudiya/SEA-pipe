#! /bin/bash

set -x

obsinp=OBSINP
ramcopy=RAMCOPY
project_dir=PROJECT_DIR
debug=DEBUG

# Which data column to image
if [[ -n "${debug}" ]]; then
    datacolumn="CORRECTED_DATA"
else
    datacolumn="DATA"
fi


# If obsinp is a file, then we are in an array job
if [[ -f "${obsinp}" ]]; then
    taskid="${SLURM_ARRAY_TASK_ID}"
    jobid="${SLURM_ARRAY_JOB_ID}"
    obsid="$(sed -n -e ${SLURM_ARRAY_TASK_ID}p ${obsinp})"
    tmpdir="/tmp/slurm_image_${jobid}_${taskid}"
else
    taskid=1
    jobid="${SLURM_JOB_ID}"
    obsid="${obsinp}"
    tmpdir="/tmp/slurm_image_${jobid}"
fi

function test_fail {
    if [[ $1 != 0 ]] && [[ "${GXTRACK}" == "track" ]]; then
        track_task.py fail --jobid="${jobid}" --taskid="${taskid}" --finish_time="$(date +%s)"
        exit "$1"
    fi
}

# WSClean suffixes for subchannels and MFS
subchans="MFS 0000 0001 0002 0003"
# Minimum uvw for self-calibration (in lambda)
minuv=75
# S/N Level at which to choose masked pixels for deepclean
msigma=5
# S/N Threshold at which to stop cleaning
tsigma=3
# Lowering the above values will make the cleaning more aggressive and introduce a CLEAN bias and is also computationally more expensive.

# Update database
if [[ "${GXTRACK}" == "track" ]]; then
    track_task.py start --jobid="${jobid}" --taskid="${taskid}" --start_time="$(date +%s)"
fi

data_dir="${project_dir}/${obsid}"
cd "${data_dir}" || exit

metafits="${obsid}.metafits"
if [[ ! -f "${metafits}" ]] || [[ ! -s "${metafits}" ]]; then
    wget -O "${metafits}" "http://ws.mwatelescope.org/metadata/fits?obs_id=${obsid}"
    test_fail $?
fi

# Set up telescope-configuration-dependent options
if [[ "${obsid}" -lt 1151402936 ]]; then
    telescope="MWA128T"
    basescale=1.1
    imsize=4000
    robust=-1.0
elif [[ "${obsid}" -ge 1151402936 ]] && [[ "${obsid}" -lt 1191580576 ]]; then
    telescope="MWAHEX"
    basescale=2.0
    imsize=2000
    robust=-2.0
elif [[ "${obsid}" -ge 1191580576 ]] && [[ "${obsid}" -lt 1391300000 ]]; then
    telescope="MWALB"
    basescale=0.6
    imsize=8000
    robust=0.5
elif [[ "${obsid}" -gt 1391300000 ]] && [[ "${obsid}" -lt 1400000000 ]]; then
    telescope="MWALB"
    basescale=0.6
    # HACK because we are doing single dipole tests!
    imsize=8000
    robust=0.5
else
    # State of play in mid-2025 -- lots of short baselines so downweight them
    telescope="MWALB"
    basescale=0.6
    imsize=8000
    robust=-1
    dynweight="natural"
fi

# Set up channel-dependent options
chan="$(pyhead.py -p CENTCHAN ${metafits} | awk '{print $3}')"
bandwidth="$(pyhead.py -p BANDWDTH ${metafits} | awk '{print $3}')"
centfreq="$(pyhead.py -p FREQCENT ${metafits} | awk '{print $3}')"
chans="$(pyhead.py -p CHANNELS ${metafits} | awk '{print $3}' | sed 's/,/ /g')"
chans=($chans)

# Pixel scale
# At least 4 pix per synth beam for each channel
scale=$(echo "$basescale / $chan" | bc -l)

# Naming convention for output files
lowfreq=$(echo "${centfreq}" "${bandwidth}" | awk '{printf("%00d\n",$1-($2/2.)+0.5)}')
highfreq=$(echo "$centfreq $bandwidth" | awk '{printf("%00d\n",$1+($2/2.)+0.5)}')
freqrange="${lowfreq}-${highfreq}"

# Calculate min uvw in metres
minuvm=$(echo "234 * $minuv / $chan" | bc -l)

# Found that multiscale cleaning recovers flux density in the extragalactic sky better than not, and doesn't add much to processing time.
# multiscale="-multiscale -mgain 0.85 -multiscale-gain 0.15" # If you really want to use multiscale.
multiscale="-mgain 0.85" # For transient searches, we can be off with not using multiscale.

if [[ -n "${ramcopy}" ]]; then
    mkdir -p "${tmpdir}"
    cp -r "${obsid}.ms" "${tmpdir}/"
    ms="${tmpdir}/${obsid}.ms"
else
    ms="${obsid}.ms"
fi

if [[ ! -e "${obsid}_mainlobes.txt" ]]; then 
    get_mwa_pb_lobes.py ${metafits} -mM > ${obsid}_mainlobes.txt
    ra_mainlobe=$(cat ${obsid}_mainlobes.txt | awk '{print $2}')
    dec_mainlobe=$(cat ${obsid}_mainlobes.txt | awk '{print $3}')
else
    ra_mainlobe=$(cat ${obsid}_mainlobes.txt | awk '{print $2}')
    dec_mainlobe=$(cat ${obsid}_mainlobes.txt | awk '{print $3}')
fi

gal_check="$(check_src_fov.py -p ${ra_mainlobe} ${dec_mainlobe} -g)"
vira_check="$(check_src_fov.py -p ${ra_mainlobe} ${dec_mainlobe} -s "VirA")"

if [[ "${gal_check}" == "True" ]] || [[ "${vira_check}" == "True" ]]; then 
    echo "There is either gal plane or VirA in FoV so changing multiscale scale bias" 
    scalebias="-multiscale-scale-bias 0.7"
else
    scalebias="-multiscale-scale-bias 0.6"
fi 

# Check whether the phase centre has already changed
current="$(chgcentre "${ms}")"

if [[ "${current}" == *"shift"* ]]; then
    echo "Detected that this measurement set has already had its phase centre changed. Not shifting."
else
    # Determine whether to shift the pointing centre to be more optimally-centred 
    # on the peak of the primary beam sensitivity
    coords="$(calc_pointing.py ${metafits})"
    echo "Optimally shifting co-ordinates of measurement set to $coords, with zenith shiftback."
    chgcentre "${ms}" "${coords}"

    # Now shift the pointing centre to point straight up, 
    # which approximates minw without making the phase centre rattle around
    chgcentre -zenith -shiftback "${ms}"
fi

# Create a template image that has all the same properties as our eventual WSClean image
if [[ ! -e "${obsid}_template.fits" ]]; then
    echo "Creating template image for ${obsid}."
    wsclean \
        -abs-mem "${PROGMEMORY}" \
        -mgain 1.0 \
        -nmiter 1 \
        -niter 0 \
        -name "${obsid}_template" \
        -size "${imsize}" "${imsize}" \
        -scale "${scale:0:8}" \
        -pol XX \
        -data-column "${datacolumn}" \
        -channel-range 4 5 \
        -interval 4 5 \
        -nwlayers "${IMNCPUS}" \
        "${ms}"

    rm "${obsid}_template-dirty.fits"
    mv "${obsid}_template-image.fits" "${obsid}_template.fits"
else
    echo "Using existing template image for ${obsid}."
fi

# Hardcoding John's PB script location for now
# Also hardcoding creating four sub-band beams
pols="XX XXi XY XYi YX YXi YY YYi"

for n in {0..3}; do
    i=$((n * 6))
    cstart=${chans[$i]}
    j=$((i + 5))
    cend=${chans[$j]}
    for pol in $pols; do 
        if [[ ! -e "${obsid}_000${n}-${pol}-beam.fits" ]]; then
            lookup_jones.py ${obsid} _template.fits ${obsid}_000${n}- -c $cstart-$cend --wsclean_names
        fi
        ln -s "${obsid}_000${n}-${pol}-beam.fits" "${obsid}_deep-000${n}-beam-${pol}.fits"
    done
done

# Set the pipefail so the test_fail does not test for tee
set -o pipefail
# Deep clean (for pipeline)
wsclean \
    -abs-mem "${PROGMEMORY}" \
    "${multiscale}" \
    "${scalebias}" \
    -nmiter 3 \
    -niter 10000000 \
    -reuse-primary-beam \
    -apply-primary-beam \
    -auto-mask "${msigma}" \
    -auto-threshold "${tsigma}" \
    -name "${obsid}_deep" \
    -size "${imsize}" "${imsize}" \
    -scale "${scale:0:8}" \
    -weight briggs "${robust}" \
    -pol I \
    -join-channels \
    -channels-out 4 \
    -save-source-list \
    -fit-spectral-pol 2 \
    -data-column "${datacolumn}" \
    "${ms}" | tee wsclean.log

    # -mwapath ${GXMWAPB} \ # For calculating the primary beam on-the-fly. Replace --reuse-primary-beam with this if you encounter errors with "the primary beam not found" by lookup_jones.py.

test_fail $?

# Move back the measurement set to the original location if we copied it to RAM
if [[ -n "${ramcopy}" ]]; then
    rm -rf "${data_dir}/${obsid}.ms"
    mv "${ms}" "${data_dir}/"
    rm -rf "${tmpdir}"
fi

if [[ "${GXTRACK}" == "track" ]]; then
    track_task.py finish --jobid="${jobid}" --taskid="${taskid}" --finish_time="$(date +%s)"
    track_task.py obs_status --obs_id="${obsid}" --status='imaged'
fi
